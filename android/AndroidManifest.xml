<?xml version="1.0" encoding="utf-8"?>
<!--
  Q.E.D.! for Android: a thin WebView shell around the same single-file game as the web version.
  - The game ships inside the APK (assets/game/index.html), so it works offline from the first launch.
  - Newer game builds are downloaded from the project's GitHub Pages branch, but only installed after their
    signature checks out against the public key compiled into this app (see Updater.java and UpdateCheck.java).
  - The only permission is INTERNET, used only by Updater.java. The game page itself has no network access.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.qed">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Q.E.D.!"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
