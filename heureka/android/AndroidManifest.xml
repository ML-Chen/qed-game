<?xml version="1.0" encoding="utf-8"?>
<!--
  Heurēka! for Android: the same thin WebView shell as Q.E.D.! (android/src), built with APP=heureka android/build.sh.
  The build copies the Java sources, renames the package to app.heureka and points the updater at
  https://ml-chen.github.io/qed-game/heureka/update/, whose signed manifest must say "app": "heureka".
  - The game ships inside the APK (assets/game/index.html), so it works offline from the first launch.
  - Newer game builds are only installed after their signature checks out against the public key compiled into this app.
  - The only permission is INTERNET, used only by Updater.java. The game page itself has no network access.
  Keep this file in step with android/AndroidManifest.xml; only the package and the label differ.
  The launcher icons are in heureka/android/res.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.heureka">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Heurēka!"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
